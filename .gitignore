# Python caches and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*
!.env.example

# Temporary and generated model artifacts
*.tmp
*.temp
*.log
models/
artifacts/
checkpoints/
*.pkl
*.joblib
*.h5
*.onnx
!backend/models/
!backend/models/*.py

# Generated persistent RAG vector-store data
/data/rag_documents/chroma/

# Keep the small, versioned synthetic CSV datasets in data/raw.

# Large external Computer Vision dataset files; retain the dataset documentation and manifest.
/data/external/disaster_images/*
!/data/external/disaster_images/README.md
!/data/external/disaster_images/metadata.csv
!/data/external/disaster_images/corrupted_images.csv

# User-uploaded case evidence; keep local and out of source control.
/data/raw/images/uploads/
